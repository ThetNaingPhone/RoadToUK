// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  applications Application[]
  advice       Advice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPER_ADMIN)

  activityLogs AdminActivityLog[]

  createdCountries        Country[]         @relation("CreatedCountries")
  updatedCountries        Country[]         @relation("UpdatedCountries")
  createdUniversities     University[]      @relation("CreatedUniversities")
  updatedUniversities     University[]      @relation("UpdatedUniversities")
  createdVisaRequirements VisaRequirement[] @relation("CreatedVisaRequirements")
  updatedVisaRequirements VisaRequirement[] @relation("UpdatedVisaRequirements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  EDITOR
}

model Country {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?

  universities     University[]
  visaRequirements VisaRequirement[]
  advice           Advice[]
  applications     Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   Admin  @relation("CreatedCountries", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   Admin?  @relation("UpdatedCountries", fields: [updatedById], references: [id])
}

model University {
  id          String  @id @default(cuid())
  name        String
  countryId   String
  country     Country @relation(fields: [countryId], references: [id])
  ranking     Int?
  description String?

  visaRequirements VisaRequirement[]
  advice           Advice[]
  applications     Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   Admin  @relation("CreatedUniversities", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   Admin?  @relation("UpdatedUniversities", fields: [updatedById], references: [id])
}

model VisaRequirement {
  id             String      @id @default(cuid())
  countryId      String
  country        Country     @relation(fields: [countryId], references: [id])
  universityId   String?
  university     University? @relation(fields: [universityId], references: [id])
  documents      String
  fees           Float
  processingTime Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   Admin  @relation("CreatedVisaRequirements", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   Admin?  @relation("UpdatedVisaRequirements", fields: [updatedById], references: [id])
}

model Advice {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  countryId    String?
  country      Country?    @relation(fields: [countryId], references: [id])
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  content      String
  createdAt    DateTime    @default(now())
}

model Application {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  countryId    String
  country      Country    @relation(fields: [countryId], references: [id])
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  status       String
  submittedAt  DateTime   @default(now())
}

model AdminActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    String?
}
